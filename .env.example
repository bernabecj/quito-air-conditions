# Copy to .env and fill in. .env is gitignored.

# --- Producers -------------------------------------------------------------
# Where producers write: "file" (JSON Lines under FILE_SINK_DIR) or "kafka".
SINK=file
FILE_SINK_DIR=data/local/sink

# Kafka, required when SINK=kafka. Values from Confluent Cloud or Redpanda.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CLIENT_ID=airquito-producer

# --- Discovery scripts only --------------------------------------------------
# OpenAQ v3, free key from https://explore.openaq.org/register (scripts/discover_stations.py)
OPENAQ_API_KEY=
# Optional, read by scripts/probe_sources.py; probes are skipped when unset.
PURPLEAIR_API_KEY=
# WAQI is a manual cross check only: its terms forbid storing the data.
WAQI_TOKEN=
